{
  "name": "autobrowser",
  "productName": "AutoBrowser",
  "version": "2.0.7",
  "description": "AutoBrowser Electron + TypeScript + CloakBrowser",
  "main": "dist/main/index.js",
  "private": true,
  "scripts": {
    "clean": "rimraf dist release",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:renderer": "vite build",
    "build": "npm run clean && npm run build:main && npm run build:preload && npm run build:renderer",
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.main.json -w",
    "start": "npm run build && electron .",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist": "npm run build && electron-builder",
    "postinstall": "electron-builder install-app-deps || true"
  },
  "dependencies": {
    "cloakbrowser": "^0.3.28",
    "p-limit": "^3.1.0",
    "pino": "^9.5.0",
    "playwright": "^1.48.0",
    "playwright-core": "^1.60.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.0.0",
    "electron": "^31.7.7",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "zustand": "^5.0.2"
  }
}
