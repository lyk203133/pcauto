{
  "name": "本地测试任务",
  "domain": "http://localhost:8091",
  "description": "测试本地服务",
  "enabled": true,
  "steps": [
    {
      "type": "goto",
      "url": "http://localhost:8091/Public.login.do",
      "wait": "3"
    },
    {
      "type": "fill",
      "selector": "#username",
      "value": "admin",
      "wait": "0.5"
    },
    {
      "type": "fill",
      "selector": "#password",
      "value": "123456",
      "wait": "0.5"
    },
    {
      "type": "click",
      "selector": "#loginBtn",
      "wait": "2"
    },
    {
      "type": "wait",
      "seconds": "300",
      "wait": "1"
    },
    {
      "type": "screenshot",
      "name": "localhost_result",
      "wait": "1"
    }
  ]
}
